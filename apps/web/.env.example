# --- Database (PostgreSQL 14+) ---
DATABASE_URL=postgresql://nexora:nexora@localhost:5432/nexora

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Required when deployed behind a proxy / on your own domain:
# AUTH_URL=https://your-domain.example
# AUTH_TRUST_HOST=true
